# Copy to .env for local development. Never commit real values.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database — SQLite for local development
DB_CLIENT=better-sqlite3
SQLITE_PATH=data/dev.sqlite
# PostgreSQL for production (Phase 7):
# DB_CLIENT=pg
# DATABASE_URL=postgres://user:password@localhost:5432/student_progress

# Auth. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-character-string
SESSION_COOKIE_NAME=spd.sid
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
# Local demo only: one shared password instead of random generated passwords.
# Also used by "npm run db:demo" to provision the fictional demo student.
# Leave blank to use the documented local-only demo default.
DEMO_DEFAULT_PASSWORD=
# Set to an imported student email to grant the admin-only import role.
ADMIN_EMAIL=

# Private imported spreadsheets and local credentials (gitignored)
PRIVATE_DATA_DIR=data/private
IMPORT_MAX_FILE_BYTES=10485760
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Client — Vite reads this file via envDir in client/vite.config.ts
VITE_API_BASE_URL=/api/v1
# Integrated local mode talks to Express. Set to true only for an isolated
# frontend preview backed entirely by MSW fixtures.
VITE_ENABLE_MOCKS=false

# AI Coach — Google Gemini, server-side only. Never expose this key to Vite or
# the browser. Leave the key blank to use the deterministic fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000
COACH_RATE_LIMIT_MAX=20
COACH_RATE_LIMIT_WINDOW_MINUTES=15
COACH_ASK_RATE_LIMIT_MAX=10
# Assessment results are not available yet; future adapters must be verified.
ASSESSMENT_DATA_ADAPTER=unavailable
